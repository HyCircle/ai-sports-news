# PostgreSQL 18 + pgvector DSN
SPNEWS_DATABASE_URL=postgresql://spnews:change-me@127.0.0.1:5432/spnews

# Chat LLM (OpenAI-compatible: DeepSeek or OpenRouter)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
# Or use OpenRouter for chat too:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-6-luna
# LLM_API_KEY=your-key

# Embedding API (OpenRouter qwen/qwen3-embedding-8b)
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_API_KEY=your-openrouter-api-key

# Site & timezone
SITE_URL=https://sports.yhao.dev
TIMEZONE=America/Chicago
